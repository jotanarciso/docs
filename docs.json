{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Soundlink API",
  "colors": {
    "primary": "#000000",
    "light": "#ffffff",
    "dark": "#000000"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@getsoundlink.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://getsoundlink.com"
    }
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": ["curl", "python", "javascript"],
      "defaults": "required"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "authentication", "errors"]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi/soundlink-public-api-v1.yaml"
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://getsoundlink.com"
    }
  }
}
